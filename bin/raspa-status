#!/bin/bash

set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
if [[ "$SCRIPT_SOURCE" != /* ]]; then
  SCRIPT_SOURCE="$(type -P -- "$SCRIPT_SOURCE" || true)"
fi
if [[ -z "${SCRIPT_SOURCE:-}" ]]; then
  echo "Error: unable to resolve raspa-status path." >&2
  exit 1
fi
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_SOURCE="$(readlink -f -- "$SCRIPT_SOURCE" 2>/dev/null || echo "$SCRIPT_SOURCE")"
fi

ROOT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")"/../.. && pwd -P)"
STATUS_CMD_NAME="raspa-status" exec bash "$ROOT_DIR/.raspa_tools/scripts/shell/entrypoints/scale.sh" status "$@"
