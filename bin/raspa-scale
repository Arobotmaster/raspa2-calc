#!/bin/bash

# 动态调整并发：
# 1) 写入工作目录子目录下的 .raspa_worker_limit，控制工人在任务边界自觉退出/继续
# 2) 如果是 loop 模式（逐个 sbatch），自动补交缺口（扩容），按“当前任务运行时间最短优先”选择并 scancel（缩容）
# 3) 如果是 SLURM 数组作业，尝试更新 ArrayTaskThrottle（仅当命名匹配且权限允许）

set -euo pipefail

usage() {
  echo "用法: raspa-scale [选项] <并发上限|省略以交互> [子目录]"
  echo "说明: 在当前工作目录下，设置允许并发的最大工人数；可选指定子目录（默认自动检测）"
  echo "      在SLURM loop模式下：会自动补交/取消作业以接近目标值；在PBS/本地，仅设置上限文件。"
  echo "选项:"
  echo "  -i, --interactive, interactive  进入交互模式，先展示集群资源与可用任务，再输入并发上限"
  echo "  -h, --help                      显示此帮助信息"
  echo "  -y, --accept                    非交互自动采用建议值（无标准输入或CI中很有用）"
}

insert_exports_after_sbatch() {
  local script_path="$1"
  shift || true
  if [ $# -eq 0 ]; then
    return 0
  fi
  python3 - "$script_path" "$@" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
exports = sys.argv[2:]

if not path.exists():
    sys.exit(0)

content = path.read_text(encoding="utf-8").splitlines()
if not content:
    sys.exit(0)

header = [content[0]]
idx = 1
while idx < len(content) and content[idx].startswith("#SBATCH"):
    header.append(content[idx])
    idx += 1

rest = content[idx:]

with path.open("w", encoding="utf-8") as fh:
    for line in header:
        fh.write(line + "\n")
    for exp in exports:
        fh.write(exp + "\n")
    for line in rest:
        fh.write(line + "\n")
PY
}

INTERACTIVE=0
ACCEPT_AUTO=0
RAW_LIMIT=""
RAW_SUBDIR=""

while [ $# -ge 1 ]; do
  case "${1:-}" in
    -i|--interactive|interactive|ask)
      INTERACTIVE=1; shift || true ;;
    -h|--help)
      usage; exit 0 ;;
    -y|--accept)
      ACCEPT_AUTO=1; shift || true ;;
    *) break ;;
  esac
done

if [ $# -ge 1 ]; then
  if [[ "$1" =~ ^[0-9]+$ ]]; then
    RAW_LIMIT="$1"
    shift || true
  fi
fi

RAW_SUBDIR=${1:-""}

ABS_PWD="$(pwd -P)"
ROOT_DIR="$(cd "$(dirname "$0")"/../.. && pwd)"

# 尝试在当前路径向上寻找 job_templates 目录
BASE_DIR="$ABS_PWD"
while [ "$BASE_DIR" != "/" ] && [ ! -d "$BASE_DIR/job_templates" ]; do
  BASE_DIR="$(dirname "$BASE_DIR")"
done
if [ ! -d "$BASE_DIR/job_templates" ]; then
  echo "错误: 未在当前路径及其父目录中找到 job_templates，请在项目工作目录下执行" >&2
  exit 1
fi

# 计算当前目录相对于 BASE_DIR 的子路径
if [ "$ABS_PWD" = "$BASE_DIR" ]; then
  DEFAULT_SUBDIR="."
else
  DEFAULT_SUBDIR="${ABS_PWD#$BASE_DIR/}"
fi

# 解析子目录（若传入则使用，否则自动检测）
if [ -n "$RAW_SUBDIR" ]; then
  SUBDIR="$RAW_SUBDIR"
else
  SUBDIR="$DEFAULT_SUBDIR"
fi

if [ "$SUBDIR" = "." ]; then
  TARGET_DIR="$BASE_DIR"
else
  TARGET_DIR="$BASE_DIR/$SUBDIR"
fi
TARGET_DIR="$(cd "$TARGET_DIR" && pwd -P)"
if [ ! -d "$TARGET_DIR" ]; then
  echo "错误: 目标目录不存在: $TARGET_DIR" >&2
  exit 1
fi

echo "工作根目录: $BASE_DIR"
echo "目标子目录: $SUBDIR"

LIMIT_FILE="$TARGET_DIR/.raspa_worker_limit"

# 在设置并发前输出资源与可用任务概览；若交互或未提供数值，则提示输入
ts() { date +"%Y-%m-%d %H:%M:%S,%3N"; }
node_cpu_count() { command -v nproc >/dev/null 2>&1 && nproc || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1; }

RUNNING_COUNT=$(find "$TARGET_DIR" -maxdepth 1 -type d -name 'mc*__running' 2>/dev/null | wc -l | awk '{print $1}')
PENDING_COUNT=0
while IFS= read -r d; do
  [ -f "$d/simulation.input" ] && PENDING_COUNT=$((PENDING_COUNT+1))
done < <(find "$TARGET_DIR" -maxdepth 1 -type d -name 'mc[0-9]*' ! -name '*__*' -printf '%p\n' 2>/dev/null)
USEFUL_TASKS=$((RUNNING_COUNT + PENDING_COUNT))

CL_TOTAL=0; CL_ALLOC=0; CL_OTHER=0; CL_IDLE=0
CL_METHOD="none"
declare -a CL_NODE_LINES=()

# 优先使用统一的 Python 资源探测，保持与 raspa-calc 一致
PY_RES_JSON=""
PY_RES_JSON=$(python "$ROOT_DIR/.raspa_tools/scripts/python/cluster_info.py" 2>/dev/null || true)
if [ -n "$PY_RES_JSON" ] && echo "$PY_RES_JSON" | grep -q '"available"'; then
  PY_OK=$(python - "$PY_RES_JSON" <<'PY' 2>/dev/null || true
import json,sys
try:
  d=json.loads(sys.stdin.read())
  if not d.get('available'): raise SystemExit(1)
  print(d.get('total_cpus',0), d.get('allocated_cpus',0), d.get('available_cpus',0))
  for n in d.get('nodes') or []:
    nm=n.get('node')
    tot=n.get('total_cpus',0)
    alloc=n.get('allocated_cpus',0)
    topo=n.get('topology') or '?'
    load=n.get('load')
    free=n.get('free_cpus',0)
    print(f"NODE::{nm}::{tot}::{alloc}::{topo}::{load if load is not None else '未知'}::{free}")
except Exception:
  raise SystemExit(1)
PY
  )
  if [ -n "$PY_OK" ]; then
    # 解析三元组与节点行
    first_line=$(printf "%s\n" "$PY_OK" | head -n1)
    read -r CL_TOTAL CL_ALLOC CL_IDLE <<< "$first_line"
    while IFS= read -r L; do
      case "$L" in NODE::*)
        IFS='::' read -r _ tag_nm tag_tot tag_alloc tag_topo tag_load tag_free <<< "$L"
        CL_NODE_LINES+=("  ${tag_nm}: 总${tag_tot}线程 (拓扑${tag_topo}), 已分配${tag_alloc}, CPULoad=${tag_load}, 估计可用=${tag_free}")
      ;; esac
    done < <(printf "%s\n" "$PY_OK")
    CL_METHOD="python_task_runner"
  fi
fi

# 兜底：仍然尝试本地 sinfo（带超时）
if [ "$CL_METHOD" = "none" ] && command -v sinfo >/dev/null 2>&1; then
  if out=$(timeout 5s sinfo -N -h -o '%N|%c|%C|%O|%z' 2>/dev/null); then
    if [ -n "$out" ]; then
      while IFS='|' read -r nm cCpt Csum load topo; do
        [ -z "$nm" ] && continue
        IFS='/' read -r c_alloc c_idle c_other c_total <<< "$Csum"
        c_alloc=${c_alloc:-0}; c_idle=${c_idle:-0}; c_other=${c_other:-0}; c_total=${c_total:-${cCpt:-0}}
        free=$(( c_total - c_alloc - c_other ))
        [ "$free" -lt 0 ] && free=0
        CL_TOTAL=$((CL_TOTAL + c_total))
        CL_ALLOC=$((CL_ALLOC + c_alloc))
        CL_OTHER=$((CL_OTHER + c_other))
        CL_IDLE=$((CL_IDLE + free))
        load_disp="$load"; [ -z "$load_disp" ] && load_disp="未知"
        CL_NODE_LINES+=("  ${nm}: 总${c_total}线程 (拓扑${topo:-?}), 已分配${c_alloc}, CPULoad=${load_disp}, 估计可用=${free}")
      done <<< "$out"
      CL_METHOD="sinfo_per_node"
    fi
  fi
  if [ "$CL_METHOD" = "none" ]; then
    if out=$(timeout 3s sinfo -h -o '%C' 2>/dev/null); then
      IFS='/' read -r c_alloc c_idle c_other c_total <<< "${out%%$'\n'*}"
      CL_ALLOC=${c_alloc:-0}; idle=${c_idle:-0}; CL_OTHER=${c_other:-0}; CL_TOTAL=${c_total:-0}; CL_IDLE=${idle:-0}
      CL_METHOD="sinfo_summary"
    fi
  fi
fi

echo "$(ts) - INFO - === 步骤3：设置计算参数 ==="
echo "$(ts) - INFO - 当前节点CPU核心数: $(node_cpu_count)"
if [ "$CL_METHOD" != "none" ]; then
  echo "$(ts) - INFO - SLURM集群总 CPU核心数: ${CL_TOTAL}"
  echo "$(ts) - INFO - SLURM集群已分配 CPU核心数: ${CL_ALLOC}"
  echo "$(ts) - INFO - SLURM集群当前可用 CPU核心数: ${CL_IDLE}"
  if [ "$CL_METHOD" = "sinfo_per_node" ] && [ ${#CL_NODE_LINES[@]} -gt 0 ]; then
    echo "$(ts) - INFO - 节点资源详情（线程总数/负载/建议可用线程）："
    for line in "${CL_NODE_LINES[@]}"; do
      echo "$(ts) - INFO - ${line}"
    done
  fi
else
  echo "$(ts) - INFO - 未检测到SLURM集群环境，使用当前节点信息"
fi

echo "$(ts) - INFO - 可用任务数: ${USEFUL_TASKS} (运行中=${RUNNING_COUNT}, 待处理=${PENDING_COUNT})"
RECOMMENDED=$USEFUL_TASKS
if [ "$CL_METHOD" != "none" ] && [ "$CL_IDLE" -gt 0 ]; then
  if [ "$RECOMMENDED" -gt "$CL_IDLE" ]; then RECOMMENDED=$CL_IDLE; fi
fi
[ "$RECOMMENDED" -lt 0 ] && RECOMMENDED=0
echo "$(ts) - INFO - 建议使用CPU核心数: ${RECOMMENDED} (基于集群空闲资源)"

CUR_LIMIT=""; [ -f "$LIMIT_FILE" ] && CUR_LIMIT=$(awk 'NR==1{print $1}' "$LIMIT_FILE" 2>/dev/null || true)
NON_TTY=1; [ -t 0 ] && NON_TTY=0

if [ -n "$RAW_LIMIT" ]; then
  NEW_LIMIT="$RAW_LIMIT"
else
  # 无显式数值时，依据交互/TTY/接受策略自动选择
  if [ "$USEFUL_TASKS" -eq 0 ]; then
    echo "$(ts) - INFO - 可用任务数为0：不建议提高并发，保持当前上限${CUR_LIMIT:+=$CUR_LIMIT}"
    if [ "$INTERACTIVE" -eq 1 ]; then
      echo "$(ts) - INFO - 交互已跳过（无可用任务）。如需强制设置，请显式给出数值。"
    fi
    # 保持不变：若已有上限则沿用，否则使用1占位（不会触发补交）
    NEW_LIMIT=${CUR_LIMIT:-1}
  else
    if [ "$INTERACTIVE" -eq 1 ]; then
      prompt="请输入并发上限 (1-${USEFUL_TASKS}) [建议:${RECOMMENDED}${CUR_LIMIT:+, 当前:${CUR_LIMIT}}]: "
      read -r -p "$prompt" input_limit || input_limit=""
      if [ -z "$input_limit" ]; then
        NEW_LIMIT=${RECOMMENDED:-1}
      else
        NEW_LIMIT="$input_limit"
      fi
    else
      if [ "$ACCEPT_AUTO" -eq 1 ] || [ "$NON_TTY" -eq 1 ]; then
        NEW_LIMIT=${RECOMMENDED:-1}
        echo "$(ts) - INFO - 自动采用建议并发: $NEW_LIMIT"
      else
        # 有TTY但未显式 -i/-y：仍自动采用建议值，避免误阻塞
        NEW_LIMIT=${RECOMMENDED:-1}
        echo "$(ts) - INFO - 采用建议并发: $NEW_LIMIT（使用 -i 可交互输入，或 -y 自动接受）"
      fi
    fi
  fi
fi

if ! [[ "$NEW_LIMIT" =~ ^[0-9]+$ ]] || [ "${NEW_LIMIT}" -lt 1 ]; then
  echo "错误: 并发上限必须为正整数 (得到: '${NEW_LIMIT}')" >&2
  exit 1
fi

echo "$NEW_LIMIT" > "$LIMIT_FILE"
echo "已设置 .raspa_worker_limit = $NEW_LIMIT ($TARGET_DIR)"

# 仅在存在 sbatch/squeue 时，尝试补交或缩容 loop 模式作业
if command -v sbatch >/dev/null 2>&1 && command -v squeue >/dev/null 2>&1; then
  JOBS_FILE="$TARGET_DIR/.raspa_jobs.list"
  WORKERS_DIR="$TARGET_DIR/.workers"
  mkdir -p "$WORKERS_DIR"

  NODE_PLAN="${RASPA_NODE_PLAN:-}"
  PLAN_FILE="$TARGET_DIR/.raspa_node_plan"
  if [ -z "$NODE_PLAN" ] && [ -f "$PLAN_FILE" ]; then
    NODE_PLAN="$(tr -d ' \t\r\n' < "$PLAN_FILE")"
  fi

  submit_missing() {
    # 参数：逗号分隔的缺口编号列表，例如 "3,5,7"
    local missing_csv="$1"
    [ -z "$missing_csv" ] && return 0
    local LOG_DIR="$TARGET_DIR/1log"
    mkdir -p "$LOG_DIR"
    local SCRIPT_DIR="$ROOT_DIR/.raspa_tools/job_templates"
    local JOB_TEMPLATE="$SCRIPT_DIR/job_submit.sh"
    local TMP_SCRIPT
    TMP_SCRIPT=$(mktemp "$TARGET_DIR/.job_submit_ht.XXXXXX.sh")
    local now
    now=$(date +%s)
    IFS=',' read -r -a arr <<< "$missing_csv"
    local -a plan_queue=()
    local plan_len=0
    if [ -n "$NODE_PLAN" ]; then
      local -a plan_entries
      IFS=',' read -r -a plan_entries <<< "$NODE_PLAN"
      local entry node count
      for entry in "${plan_entries[@]}"; do
        node="${entry%%:*}"
        count="${entry#*:}"
        if [ -n "$node" ] && [[ "$count" =~ ^[0-9]+$ ]] && [ "$count" -gt 0 ]; then
          for ((i=0; i<count; i++)); do
            plan_queue+=("$node")
          done
        fi
      done
      plan_len=${#plan_queue[@]}
    fi
    local plan_index=0
    local job_base_dir
    for name in "${arr[@]}"; do
      TARGET_NODE=""
      # 准备脚本
      cp -f "$JOB_TEMPLATE" "$TMP_SCRIPT"
      sed -i -e "s|^#SBATCH --job-name=.*|#SBATCH --job-name=${name}|" "$TMP_SCRIPT"
      if [ "$SUBDIR" = "." ]; then
        job_base_dir="$TARGET_DIR"
      else
        job_base_dir="$(cd "$TARGET_DIR/.." && pwd -P)"
      fi
      if [ -n "$NODE_PLAN" ] && [ "$plan_len" -gt 0 ]; then
        TARGET_NODE="${plan_queue[$plan_index]}"
        plan_index=$((plan_index + 1))
        if [ $plan_index -ge $plan_len ]; then
          plan_index=0
        fi
        if [ -n "$TARGET_NODE" ]; then
          sed -i -e "s|^#SBATCH --nodelist=.*|#SBATCH --nodelist=${TARGET_NODE}|" \
                 -e "s|^# #SBATCH --nodelist=.*|#SBATCH --nodelist=${TARGET_NODE}|" "$TMP_SCRIPT"
        fi
      fi
      insert_exports_after_sbatch "$TMP_SCRIPT" \
        "export RASPA_TOTAL_CPUS=\"${NEW_LIMIT}\"" \
        "export RASPA_WORK_DIR=\"${job_base_dir}\"" \
        "export RASPA_OUTPUT_DIR=\"${SUBDIR}\"" \
        "export RASPA_SUBDIR=\"${SUBDIR}\"" \
        "export RASPA_WORKER_ID=\"${name}\""
      # 提交（强制日志到 1log）
      out="$LOG_DIR/${name}.out"; err="$LOG_DIR/${name}.err"
      submit_result=$(sbatch -o "$out" -e "$err" "$TMP_SCRIPT" 2>&1)
      echo "$submit_result"
      if [[ "$submit_result" =~ Submitted\ batch\ job\ ([0-9]+) ]]; then
        jid="${BASH_REMATCH[1]}"
        # 附加记录需加锁，避免并发写入交错
        {
          exec 9>>"$JOBS_FILE"
          flock -n 9 || true
          printf "%s %s %s\n" "$jid" "$name" "$now" >&9
          flock -u 9
          exec 9>&-
        }
      fi
      sleep 0.2
    done
    rm -f "$TMP_SCRIPT" 2>/dev/null || true
  }

  # 读取当前活跃作业列表（仅统计属于本批次的 JobId）
  LIVE=0
  if [ -f "$JOBS_FILE" ]; then
    # 从 squeue 取当前我的作业 JobId 列表
    mapfile -t ALL_MY_JOBS < <(squeue -u "$USER" -h -o "%i" 2>/dev/null | sort -u)
    # 从 .raspa_jobs.list 取追踪的 JobId
    mapfile -t TRACKED < <(awk '{print $1}' "$JOBS_FILE" | sort -u)
    # 交集计数
    if [ ${#ALL_MY_JOBS[@]} -gt 0 ] && [ ${#TRACKED[@]} -gt 0 ]; then
      LIVE=$(comm -12 <(printf "%s\n" "${ALL_MY_JOBS[@]}") <(printf "%s\n" "${TRACKED[@]}" ) | wc -l)
    fi
  fi

  # 如未启用作业追踪文件，则仅写入上限，不做自动提交/缩容（避免错误扩容）
if [ ! -s "$JOBS_FILE" ]; then
    echo "提示: 未发现 $JOBS_FILE，尝试基于 scontrol 的 StdOut 路径重建..." >&2
    LOGDIR_CAND="$(ls -d "$TARGET_DIR"/*/1log 2>/dev/null | head -n1)"
    # 若当前目录就是子目录，默认日志在 ./1log
    [ -z "$LOGDIR_CAND" ] && LOGDIR_CAND="$TARGET_DIR/1log"
    touch "$JOBS_FILE"
    # 遍历当前用户的运行中/排队中的作业，筛选 StdOut 在本子目录下的
    while IFS= read -r jid; do
      [ -n "$jid" ] || continue
      sd=$(scontrol show job "$jid" 2>/dev/null | awk -F= '/StdOut=/{print $2}' | awk '{print $1}' | head -1)
      jn=$(scontrol show job "$jid" 2>/dev/null | awk -F= '/JobName=/{print $2}' | awk '{print $1}' | head -1)
      if [ -n "$sd" ] && [[ "$sd" == $TARGET_DIR/* ]] ; then
        echo "$jid ${jn:-0} $(date +%s)" >> "$JOBS_FILE"
      fi
    done < <(squeue -u "$USER" -h -o "%i")
    if [ ! -s "$JOBS_FILE" ]; then
      echo "提示: 仍无法识别本批次的 SLURM 作业，跳过自动补交/缩容（仅更新上限）" >&2
    else
      echo "已重建 $JOBS_FILE，共识别 $(wc -l < "$JOBS_FILE") 个作业" >&2
    fi
fi

  # 扩容：提交缺口（需要追踪文件）
  if [ -s "$JOBS_FILE" ] && [ "$LIVE" -lt "$NEW_LIMIT" ]; then
    # 统计当前可并发的“有意义”上限：已在跑的任务数(__running) + 待处理的任务数(mc*)
    RUNNING_COUNT=$(find "$TARGET_DIR" -maxdepth 1 -type d -name 'mc*__running' 2>/dev/null | wc -l | awk '{print $1}')
    # 仅统计存在 simulation.input 的待处理目录
    PENDING_COUNT=0
    while IFS= read -r d; do
      [ -f "$d/simulation.input" ] && PENDING_COUNT=$((PENDING_COUNT+1))
    done < <(find "$TARGET_DIR" -maxdepth 1 -type d -name 'mc[0-9]*' ! -name '*__*' -printf '%p\n' 2>/dev/null)

    # “有意义”的目标并发 = min(用户目标, RUNNING + PENDING)
    USEFUL_TARGET=$NEW_LIMIT
    TOTAL_AVAILABLE=$((RUNNING_COUNT + PENDING_COUNT))
    if [ "$TOTAL_AVAILABLE" -lt "$USEFUL_TARGET" ]; then
      USEFUL_TARGET=$TOTAL_AVAILABLE
    fi

    # 计算现存名集合，并找出 1..NEW_LIMIT 中缺口
    mapfile -t LIVE_IDS < <(comm -12 <(awk '{print $1}' "$JOBS_FILE" | sort -u) <(squeue -u "$USER" -h -o "%i" | sort -u))
    present=""
    for jid in "${LIVE_IDS[@]}"; do
      [ -n "$jid" ] || continue
      nm=$(awk -v J="$jid" '$1==J{print $2; exit}' "$JOBS_FILE")
      [ -n "$nm" ] && present+=" $nm"
    done
    # 缺口列表（按照 1..NEW_LIMIT）
    missing_list=()
    for ((i=1;i<=NEW_LIMIT;i++)); do
      case " $present " in *" $i "*) : ;; *) missing_list+=("$i");; esac
    done

    # 本次最多需要补交的数量
    NEED=$((USEFUL_TARGET - LIVE))
    [ "$NEED" -lt 0 ] && NEED=0

    # 截断缺口到 NEED 个
    to_submit=()
    if [ "$NEED" -gt 0 ] && [ ${#missing_list[@]} -gt 0 ]; then
      for x in "${missing_list[@]}"; do
        [ "${#to_submit[@]}" -ge "$NEED" ] && break
        to_submit+=("$x")
      done
    fi

    if [ ${#to_submit[@]} -gt 0 ]; then
      IFS=',' read -r -a _dump <<< "${to_submit[*]}" # no-op to please shellcheck
      submit_csv=$(IFS=,; echo "${to_submit[*]}")
      echo "扩容: 当前活跃=$LIVE, 目标=$NEW_LIMIT, 可用任务=${TOTAL_AVAILABLE}(运行中=${RUNNING_COUNT}, 待处理=${PENDING_COUNT})，计划补交=${#to_submit[@]}: ${submit_csv}"
      submit_missing "$submit_csv"
    else
      echo "扩容: 当前活跃=$LIVE, 目标=$NEW_LIMIT, 可用任务=${TOTAL_AVAILABLE}，无需补交"
    fi
  fi

  # 缩容：优先保留编号 <= NEW_LIMIT 的 worker，仅对编号 > NEW_LIMIT 的作业执行 scancel（需要追踪文件）
  if [ -s "$JOBS_FILE" ] && [ "$LIVE" -gt "$NEW_LIMIT" ]; then
    TO_KILL=$((LIVE - NEW_LIMIT))
    echo "缩容: 当前活跃=$LIVE, 目标=$NEW_LIMIT，将终止 $TO_KILL 个作业"

    # 构建当前活跃作业列表（受管的交集）
    mapfile -t LIVE_IDS < <(comm -12 <(awk '{print $1}' "$JOBS_FILE" | sort -u) <(squeue -u "$USER" -h -o "%i" | sort -u))

    # 选择编号 > NEW_LIMIT 的作业作为主要裁剪对象
    : > "$WORKERS_DIR/.kill_jobs"
    for jid in "${LIVE_IDS[@]}"; do
      [ -n "$jid" ] || continue
      name=$(awk -v J="$jid" '$1==J{print $2; exit}' "$JOBS_FILE")
      # 若未查到编号，则跳过由后续兜底处理
      if [ -n "$name" ] && [ "$name" -gt "$NEW_LIMIT" ] 2>/dev/null; then
        echo "$jid" >> "$WORKERS_DIR/.kill_jobs"
      fi
    done
    # 若候选多于需要，裁剪到 TO_KILL；若不足，按最短运行时间从剩余非保留作业中补齐
    sort -u "$WORKERS_DIR/.kill_jobs" | head -n "$TO_KILL" > "$WORKERS_DIR/.kill_jobs.crop"
    mv "$WORKERS_DIR/.kill_jobs.crop" "$WORKERS_DIR/.kill_jobs"

    CURRENT_KILL=$(wc -l < "$WORKERS_DIR/.kill_jobs" 2>/dev/null || echo 0)
    if [ "$CURRENT_KILL" -lt "$TO_KILL" ]; then
      NEED=$((TO_KILL - CURRENT_KILL))
      # 从 .workers 里选“最短运行时间”的非保留作业（编号未映射或 <=NEW_LIMIT 的不选）
      while IFS= read -r f; do
        [ -f "$f" ] || continue
        jobid=$(awk -F'=| ' '/^jobid=/{print $2}' "$f" | head -1)
        start=$(awk -F'=| ' '/^start=/{print $2}' "$f" | head -1)
        [ -z "$jobid" ] && continue
        name=$(awk -v J="$jobid" '$1==J{print $2; exit}' "$JOBS_FILE")
        # 仅当未映射编号 或 编号>NEW_LIMIT 时才纳入备选
        if [ -z "$name" ] || { [ "$name" -gt "$NEW_LIMIT" ] 2>/dev/null; }; then
          [ -z "$start" ] && start=0
          printf "%010d %s\n" "$start" "$jobid"
        fi
      done < <(find "$WORKERS_DIR" -type f -maxdepth 1 -mindepth 1 2>/dev/null) | sort -n | awk '{print $2}' | grep -vxF -f "$WORKERS_DIR/.kill_jobs" | head -n "$NEED" >> "$WORKERS_DIR/.kill_jobs"
    fi

    # 执行裁剪
    if [ -s "$WORKERS_DIR/.kill_jobs" ]; then
      while IFS= read -r jid; do
        [ -n "$jid" ] || continue
        echo "scancel $jid"
        scancel "$jid" || true
      done < "$WORKERS_DIR/.kill_jobs"
    fi
  fi

  # 缩容完成后如活跃数仍小于“有意义”的目标，按缺口补交
  mapfile -t LIVE_IDS < <(comm -12 <(awk '{print $1}' "$JOBS_FILE" | sort -u) <(squeue -u "$USER" -h -o "%i" | sort -u))
  present=""
  for jid in "${LIVE_IDS[@]}"; do
    [ -n "$jid" ] || continue
    nm=$(awk -v J="$jid" '$1==J{print $2; exit}' "$JOBS_FILE")
    [ -n "$nm" ] && present+=" $nm"
  done
  # 现存活跃数以“受管的活跃 JobId 数”计算，避免因 JobName 非 1..N 而被低估
  LIVE_COUNT=${#LIVE_IDS[@]}
  # 重新估算“有意义”的目标并发（避免在无任务可跑时强行对齐用户上限）
  RUNNING_COUNT=$(find "$TARGET_DIR" -maxdepth 1 -type d -name 'mc*__running' 2>/dev/null | wc -l | awk '{print $1}')
  PENDING_COUNT=0
  while IFS= read -r d; do
    [ -f "$d/simulation.input" ] && PENDING_COUNT=$((PENDING_COUNT+1))
  done < <(find "$TARGET_DIR" -maxdepth 1 -type d -name 'mc[0-9]*' ! -name '*__*' -printf '%p\n' 2>/dev/null)
  USEFUL_TARGET=$NEW_LIMIT
  TOTAL_AVAILABLE=$((RUNNING_COUNT + PENDING_COUNT))
  if [ "$TOTAL_AVAILABLE" -lt "$USEFUL_TARGET" ]; then
    USEFUL_TARGET=$TOTAL_AVAILABLE
  fi

  if [ "$LIVE_COUNT" -lt "$USEFUL_TARGET" ]; then
    # 构造缺口（1..NEW_LIMIT）
    missing_list=()
    for ((i=1;i<=NEW_LIMIT;i++)); do
      case " $present " in *" $i "*) : ;; *) missing_list+=("$i");; esac
    done
    NEED=$((USEFUL_TARGET - LIVE_COUNT))
    [ "$NEED" -lt 0 ] && NEED=0
    to_submit=()
    if [ "$NEED" -gt 0 ] && [ ${#missing_list[@]} -gt 0 ]; then
      for x in "${missing_list[@]}"; do
        [ "${#to_submit[@]}" -ge "$NEED" ] && break
        to_submit+=("$x")
      done
    fi
    if [ ${#to_submit[@]} -gt 0 ]; then
      submit_csv=$(IFS=,; echo "${to_submit[*]}")
      echo "补足并发: 现存=$LIVE_COUNT, 用户目标=$NEW_LIMIT, 可用任务=${TOTAL_AVAILABLE}(运行中=${RUNNING_COUNT}, 待处理=${PENDING_COUNT})，实际目标=${USEFUL_TARGET}，补交: ${submit_csv}"
      submit_missing "$submit_csv"
    else
      echo "补足并发: 现存=$LIVE_COUNT, 用户目标=$NEW_LIMIT, 可用任务=${TOTAL_AVAILABLE}，无需补交"
    fi
  fi
fi

echo "并发调整完成"
