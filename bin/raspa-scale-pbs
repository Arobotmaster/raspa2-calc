#!/bin/bash
set -euo pipefail

usage() {
  echo "用法: raspa-scale-pbs <并发上限> [子目录]"
  echo "说明: 仅在 PBS 上立即扩容/缩容当前目录(或指定子目录)的 worker（按编号与日志路径过滤）"
}

if [ $# -lt 1 ]; then usage; exit 1; fi
NEW_LIMIT="$1"; shift || true
RAW_SUBDIR=${1:-""}

ABS_PWD="$(pwd -P)"
BASE_DIR="$ABS_PWD"
while [ "$BASE_DIR" != "/" ] && [ ! -d "$BASE_DIR/job_templates" ]; do BASE_DIR="$(dirname "$BASE_DIR")"; done
[ -d "$BASE_DIR/job_templates" ] || { echo "错误: 未找到 job_templates，需在项目目录中执行" >&2; exit 1; }

if [ -n "$RAW_SUBDIR" ]; then SUBDIR="$RAW_SUBDIR"; else
  if [ "$ABS_PWD" = "$BASE_DIR" ]; then SUBDIR="."; else SUBDIR="${ABS_PWD#$BASE_DIR/}"; fi
fi

if [ "$SUBDIR" = "." ]; then TARGET_DIR="$BASE_DIR"; else TARGET_DIR="$BASE_DIR/$SUBDIR"; fi
TARGET_DIR="$(cd "$TARGET_DIR" && pwd -P)"

echo "$NEW_LIMIT" > "$TARGET_DIR/.raspa_worker_limit"
echo "已设置 .raspa_worker_limit = $NEW_LIMIT ($TARGET_DIR)"

command -v qsub >/dev/null 2>&1 && command -v qstat >/dev/null 2>&1 || { echo "错误: 未检测到 PBS (qsub/qstat)" >&2; exit 1; }

WORKERS_DIR="$TARGET_DIR/.workers"; mkdir -p "$WORKERS_DIR"
mapfile -t PRESENT_IDS < <(find "$WORKERS_DIR" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | awk '/^[0-9]+$/' | sort -n)
LIVE=${#PRESENT_IDS[@]}

# 统计待处理任务，避免过度扩容
RUNNING_COUNT=$(find "$TARGET_DIR" -maxdepth 1 -type d -name 'mc*__running' 2>/dev/null | wc -l | awk '{print $1}')
PENDING_COUNT=0; while IFS= read -r d; do [ -f "$d/simulation.input" ] && PENDING_COUNT=$((PENDING_COUNT+1)); done < <(find "$TARGET_DIR" -maxdepth 1 -type d -name 'mc[0-9]*' ! -name '*__*' -printf '%p\n' 2>/dev/null)
TOTAL_AVAILABLE=$((RUNNING_COUNT + PENDING_COUNT))

# 收集当前目录的数字命名作业列表（带 walltime），用于去重与裁剪
mapfile -t PBS_LINES < <(qstat -u "$USER" 2>/dev/null | tail -n +3 | awk '$1 ~ /\./ {print $1,$2}')
: > "$WORKERS_DIR/.jobs_cur"
for line in "${PBS_LINES[@]}"; do
  jid="${line%% *}"; name="${line#* }"
  [[ "$name" =~ ^[0-9]+$ ]] || continue
  jobinfo=$(qstat -f "$jid" 2>/dev/null || true)
  # 安全过滤：需属于当前目录 1log（Output_Path 或 Error_Path）
  if printf '%s' "$jobinfo" | grep -E "(Output_Path|Error_Path)\s*=" >/dev/null 2>&1; then
    if printf '%s' "$jobinfo" | grep -q '/1log/' && printf '%s' "$jobinfo" | grep -q "$TARGET_DIR"; then
      wall=$(printf '%s' "$jobinfo" | awk -F'=' '/resources_used.walltime/{gsub(/\r|\n| /,""); print $2; exit}')
      if [ -n "$wall" ]; then IFS=':' read -r h m s <<< "${wall:-0:0:0}"; h=${h:-0}; m=${m:-0}; s=${s:-0}; wallsec=$((10#$h*3600 + 10#$m*60 + 10#$s)); else wallsec=0; fi
      printf '%s %s %08d\n' "$name" "$jid" "$wallsec" >> "$WORKERS_DIR/.jobs_cur"
    fi
  fi
done

# 去重：同名多作业仅保留 walltime 最大的一个，其余全部回收（最短优先）
if [ -s "$WORKERS_DIR/.jobs_cur" ]; then
  dup_killed=0
  # 输出需要回收的重复项 jid 列表（每个 name 保留 walltime 最大的一个）
  while IFS= read -r jid; do
    echo "qdel $jid (duplicate)"; qdel "$jid" || true; dup_killed=$((dup_killed+1))
  done < <(awk '{n=$1; jid=$2; w=$3; if (!(n in keep) || w>keepw[n]) {if (n in keep) dups[keep[n]]=1; keep[n]=jid; keepw[n]=w} else {dups[jid]=1}} END {for (j in dups) print j}' "$WORKERS_DIR/.jobs_cur")
fi

# 计算唯一 name 数（基于目录匹配），作为更准确的“活跃估计”
UNIQUE_LIVE=0
if [ -s "$WORKERS_DIR/.jobs_cur" ]; then
  UNIQUE_LIVE=$(awk '{n[$1]=1} END {c=0; for (k in n) c++; print c}' "$WORKERS_DIR/.jobs_cur")
fi
# 若因 qstat 解析异常未识别到，但文件系统显示仍有 __running，则回退到运行中文件夹数
if [ "$UNIQUE_LIVE" -eq 0 ] && [ "$RUNNING_COUNT" -gt 0 ]; then
  UNIQUE_LIVE=$RUNNING_COUNT
fi

# 立刻缩容：若唯一活跃数 > 目标，按最短 walltime 优先回收到目标
if [ "$UNIQUE_LIVE" -gt "$NEW_LIMIT" ]; then
  TO_KILL=$((UNIQUE_LIVE - NEW_LIMIT))
  # 生成唯一集合（每个 name 仅保留 walltime 最大的那个）
  awk '{n=$1; jid=$2; w=$3; if (!(n in keep) || w>keepw[n]) {keep[n]=jid; keepw[n]=w}} END {for (k in keep) printf "%s %s %s\n", k, keep[k], keepw[k]}' "$WORKERS_DIR/.jobs_cur" > "$WORKERS_DIR/.unique"
  # 按 walltime 升序排序，截取需要回收的数量
  sort -k3,3n "$WORKERS_DIR/.unique" > "$WORKERS_DIR/.unique_sorted"
  killed=0
  head -n "$TO_KILL" "$WORKERS_DIR/.unique_sorted" | while read -r name jid w; do
    [ -n "$jid" ] || continue
    echo "qdel $jid (name=$name)"
    qdel "$jid" || true
    killed=$((killed+1))
  done
  if [ "$killed" -lt "$TO_KILL" ]; then
    echo "提示: 仅回收了 $killed/$TO_KILL 个作业（可能权限或状态原因）。兜底命令："
    echo "     qstat -u \"$USER\" | awk 'NR>2 {print \$1,\$2}' | awk '\$2~/^[0-9]+$/ && \$2>$NEW_LIMIT {print \$1}' | xargs -r qdel"
  fi
fi

# 立刻扩容：补交缺失编号
NEED=$((NEW_LIMIT - UNIQUE_LIVE)); [ "$NEED" -lt 0 ] && NEED=0; GAP=$((TOTAL_AVAILABLE - UNIQUE_LIVE)); [ "$GAP" -lt "$NEED" ] && NEED=$GAP
declare -a MISSING_IDS
MISSING_IDS=()
if [ "$NEED" -gt 0 ]; then
  echo "缺口: 需要补交 $NEED 个 (当前活跃=$UNIQUE_LIVE, 目标=$NEW_LIMIT, 可用任务=$TOTAL_AVAILABLE)"
  MISSING_IDS=(); for ((i=1;i<=NEW_LIMIT;i++)); do printf '%s\n' "${PRESENT_IDS[@]}" | grep -qx "$i" || MISSING_IDS+=("$i"); done
  [ ${#MISSING_IDS[@]} -gt "$NEED" ] && MISSING_IDS=("${MISSING_IDS[@]:0:$NEED}")
  RUNNER=""; if [ -x "$BASE_DIR/job_templates/tasksrun.sh" ]; then RUNNER="$BASE_DIR/job_templates/tasksrun.sh"; else RUNNER="$BASE_DIR/.raspa_tools/job_templates/tasksrun.sh"; fi
  for id in "${MISSING_IDS[@]}"; do echo "提交 worker 编号: $id"; RASPA_WORK_DIR="$BASE_DIR" RASPA_SUBDIR="$SUBDIR" RASPA_OUTPUT_DIR="$SUBDIR" RASPA_START_ID="$id" bash "$RUNNER" "$id" >/dev/null 2>&1 || true; done
fi

if [ "$UNIQUE_LIVE" -gt 0 ]; then
  echo "PBS 扩缩容完成 (当前活跃估计=$UNIQUE_LIVE, 目标=$NEW_LIMIT)"
else
  echo "PBS 扩缩容完成 (当前活跃估计=$LIVE, 目标=$NEW_LIMIT)"
fi
