#!/bin/bash

# RASPA失败任务重新检查工具 - 便捷启动脚本

# 获取工具安装目录
TOOL_DIR="$HOME/raspa2-calc/.raspa_tools"
# 获取当前工作目录
WORK_DIR="$PWD"

echo "=== RASPA失败任务重新检查工具 ==="
echo "当前工作目录: $WORK_DIR"
echo ""

# 检查重新检查脚本是否存在
RECHECK_SCRIPT="$TOOL_DIR/scripts/shell/recheck_failed.sh"
if [ ! -f "$RECHECK_SCRIPT" ]; then
    echo "错误：找不到重新检查脚本 $RECHECK_SCRIPT"
    echo "请确保RASPA工具已正确安装"
    exit 1
fi

# 切换到工作目录并运行重新检查脚本
cd "$WORK_DIR"
"$RECHECK_SCRIPT" 